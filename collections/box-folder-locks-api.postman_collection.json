      "name": "Folder Locks",
      "description": {
        "content": "Folder locks define access restrictions\nplaced by folder owners to prevent\nspecific folders from being moved or deleted.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cf63099c-e0d2-4684-981d-254e1ab9e394",
          "name": "Box List folder locks",
          "request": {
            "name": "Box List folder locks",
            "description": {
              "content": "Retrieves folder lock details for a given folder.\n\nYou must be authenticated as the owner or co-owner of the folder to\nuse this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "folder_locks"
