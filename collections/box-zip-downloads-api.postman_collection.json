        {
          "id": "ff6481af-b453-4096-9722-a4de746ad483",
          "name": "Box Download zip archive",
          "request": {
            "name": "Box Download zip archive",
            "description": {
              "content": "Returns the contents of a `zip` archive in binary format. This URL does not\nrequire any form of authentication and could be used in a user's browser to\ndownload the archive to a user's device.\n\nBy default, this URL is only valid for a few seconds from the creation of\nthe request for this archive. Once a download has started it can not be\nstopped and resumed, instead a new request for a zip archive would need to\nbe created.\n\nThe URL of this endpoint should not be considered as fixed. Instead, use\nthe [Create zip download](e://post_zip_downloads) API to request to create a\n`zip` archive, and then follow the `download_url` field in the response to\nthis endpoint.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "2.0",
                "zip_downloads",
                ":zip_download_id",
                "content"
              ],
              "host": [
                "dl",
                "boxcloud",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "zip_download_id",
                  "description": "(Required) The unique identifier that represent this `zip` archive."
