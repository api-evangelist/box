    {
      "id": "a399e8d5-4554-42c2-8865-c8a638f830ad",
      "name": "Metadata Cascade Policies",
      "description": {
        "content": "A metadata cascade policy describes how metadata\ninstances applied to a folder should be applied\nto any item within that folder.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d45669c1-dcfc-4cf9-8040-c20eb444f4aa",
          "name": "Box List metadata cascade policies",
          "request": {
            "name": "Box List metadata cascade policies",
            "description": {
              "content": "Retrieves a list of all the metadata cascade policies\nthat are applied to a given folder. This can not be used on the root\nfolder with ID `0`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metadata_cascade_policies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "folder_id",
                  "value": "<string>",
                  "description": "(Required) Specifies which folder to return policies for. This can not be used on the\nroot folder with ID `0`."
                },
                {
                  "disabled": false,
                  "key": "owner_enterprise_id",
                  "value": "<string>",
                  "description": "The ID of the enterprise ID for which to find metadata\ncascade policies. If not specified, it defaults to the\ncurrent enterprise."
                },
                {
                  "disabled": false,
                  "key": "marker",
                  "value": "<string>",
                  "description": "Defines the position marker at which to begin returning results. This is\nused when paginating using marker-based pagination.\n\nThis requires `usemarker` to be set to `true`."
